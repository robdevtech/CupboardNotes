# Cupboard Notes Environment Variables

# Dropbox OAuth App Key
# Get this from https://www.dropbox.com/developers/apps
# Create a Dropbox app with Full Dropbox access and copy the App Key
EXPO_PUBLIC_DROPBOX_APP_KEY=

# Box OAuth Credentials
# Get these from https://app.box.com/developers/console
# Create a Box app with User Authentication (OAuth 2.0) and copy the Client ID and Client Secret
# Note: Box requires client_secret (does not support PKCE for public clients)
EXPO_PUBLIC_BOX_CLIENT_ID=
EXPO_PUBLIC_BOX_CLIENT_SECRET=

# Future cloud provider keys
# EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
# EXPO_PUBLIC_ONEDRIVE_CLIENT_ID=
